# Copy to .env (local) or set these in your hosting dashboard. .env is git-ignored.

# ── AI assistant ─────────────────────────────────────────────────────────────
# Without a key the chat still works, answering from a local keyword simulation.
GEMINI_API_KEY=
# Optional: comma-separated models tried in order (must support systemInstruction).
# GEMINI_MODELS=gemini-flash-latest,gemini-2.5-flash-lite

# Optional: share rate-limit counters across serverless instances (Upstash Redis REST).
# Without these the limiter keeps per-instance counters in memory.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin used by metadata, sitemap, robots and JSON-LD.
# On Vercel the production domain is detected automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Contact form ─────────────────────────────────────────────────────────────
# Web3Forms access key (public by design). Restrict it to your domain in the
# Web3Forms dashboard. Falls back to the key bundled in the code if unset.
# NEXT_PUBLIC_WEB3FORMS_KEY=

# ── Analytics (all optional, off by default) ─────────────────────────────────
# NEXT_PUBLIC_ANALYTICS_PROVIDER=plausible   # plausible | umami | vercel
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your-domain.com
# NEXT_PUBLIC_UMAMI_SRC=https://your-umami/script.js
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
